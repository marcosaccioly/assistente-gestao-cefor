# Assistente de gestão -- credenciais
# Copie para .env (o /configurar faz isso) e preencha VOCÊ MESMO, no editor.
# Nunca cole senha ou token no chat. O .env não sai desta máquina.

# --- Sua caixa institucional (webmail do Ifes, obrigatória) ---------------------
# Mesmo login e senha do webmail. O domínio UPD1 é o do Ifes.
PESSOAL_EWS_URL=https://webmail.ifes.edu.br/EWS/Exchange.asmx
PESSOAL_DOMINIO=UPD1
PESSOAL_EMAIL=
PESSOAL_USUARIO=
PESSOAL_SENHA=

# --- Caixa do setor (opcional) ---------------------------------------------------
# Só se o setor tem caixa própria e você tem o login dela. Ative também em
# 01-gestor/fluxos/config.yaml (caixas).
SETOR_EWS_URL=https://webmail.ifes.edu.br/EWS/Exchange.asmx
SETOR_DOMINIO=UPD1
SETOR_EMAIL=
SETOR_USUARIO=
SETOR_SENHA=

# --- Kanboard (opcional) ---------------------------------------------------------
# Seu usuário do board e um token pessoal: no Kanboard, clique no seu avatar →
# Meu perfil → API → Gerar novo token.
KANBOARD_API_URL=https://board.cefor.ifes.edu.br/jsonrpc.php
KANBOARD_API_USER=
KANBOARD_API_TOKEN=

# --- Agenda Google (opcional, avançado) ------------------------------------------
# Cliente OAuth "App para computador". O refresh token é gravado por
#   bun run _pontes/calendario/facade.ts autorizar
# Só contas institucionais. CALENDARIO_CONTAS_PERMITIDAS aceita mais de uma, separadas por vírgula.
CALENDARIO_CONTA=
CALENDARIO_CLIENT_ID=
CALENDARIO_CLIENT_SECRET=
CALENDARIO_REFRESH_TOKEN=
